{
  "name": "tetherscord",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build:client": "node client/scripts/build.mjs",
    "watch:client": "node client/scripts/watch.mjs",
    "typecheck:client": "tsc -p client/tsconfig.json",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:worker",
    "test:client": "cd client && elm-test --compiler ../node_modules/elm/bin/elm",
    "test:worker": "vitest run --config worker/vitest.config.mts",
    "test": "pnpm run test:client && pnpm run test:worker",
    "build": "pnpm run build:client && pnpm run typecheck && pnpm run test",
    "dev": "pnpm run build:client && concurrently -n client,worker -c cyan,magenta \"pnpm run watch:client\" \"wrangler dev\"",
    "deploy:dry-run": "pnpm run build && wrangler deploy --dry-run",
    "deploy": "pnpm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ttrpg-activity-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply ttrpg-activity-db --remote",
    "db:migrations:list": "wrangler d1 migrations list ttrpg-activity-db --remote"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260903.1",
    "@vitest/runner": "^4.1.11",
    "@vitest/snapshot": "^4.1.11",
    "concurrently": "^10.0.5",
    "elm": "0.19.1-5",
    "elm-test": "0.19.1-revision17",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  }
}
